# Required: Linkup Search API key (pending as of initial build).
LINKUP_API_KEY=

# Optional (production persistence): if set, the app stores searches/findings
# in Turso (libSQL) instead of a local SQLite file. Required on Vercel, since
# Vercel's serverless filesystem is ephemeral/read-only at runtime and cannot
# persist a plain better-sqlite3 file across requests/deploys.
# Local dev can leave these unset and use the local SQLite file at app/data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
